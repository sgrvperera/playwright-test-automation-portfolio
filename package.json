{
  "name": "enterprise-playwright-framework",
  "version": "2.0.0",
  "description": "Enterprise-grade Playwright automation framework with UI/API testing, advanced patterns, and CI/CD integration",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "pretest": "npm run type-check",
    "demo:start": "node demo-app/server.js",
    "demo:dev": "nodemon demo-app/server.js",
    "ci": "npm run lint && npm run type-check && npm run test"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "typescript",
    "e2e",
    "api-testing",
    "page-object-model",
    "enterprise"
  ],
  "author": "Senior QA Automation Engineer",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  }
}
